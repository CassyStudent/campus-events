# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672

# Confirmation delivery; URL-encode special characters in SMTP credentials.
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM=Campus Events <events@your-verified-domain.example>
